# Rust build output. One `target/` at the workspace root: cargo puts every member's
# artifacts there, so there is nothing to ignore under `packages/`.
/target

# The prebuilt binaries staged into the platform packages before they are packed. They are
# release artifacts built from the crate, not source: the release job puts one here, and
# `nx run npm-pristine:verify-pack` puts this host's there. Committing one would ship a stale
# binary at the next release.
/npm/pristine-*/pristine

# Node dependencies and the Nx scaffold
node_modules/
.nx/
*.tsbuildinfo

# Logs and scratch output
*.log

# Agent worktrees: full checkouts of this repo living inside it. Every tool that walks
# the tree would otherwise find a second copy of every file, so Nx sees duplicate
# projects and linters check stale code.
/.worktrees/
/worktrees/

# OS noise
.DS_Store
